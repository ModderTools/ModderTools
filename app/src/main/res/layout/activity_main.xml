<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Offline state, shown instead of the WebView when there's no connection -->
    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/bg"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_body"
            android:textColor="@color/nav_icon_inactive"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/accent_ink"
            android:text="@string/retry" />

    </LinearLayout>

    <!-- Floating glass bottom navigation: Home · Search · Files · App Info -->
    <LinearLayout
        android:id="@+id/glassNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav_glass"
        android:elevation="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/navHomeWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:id="@+id/navHomePill"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
            <ImageButton
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/nav_home"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navSearchWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:id="@+id/navSearchPill"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
            <ImageButton
                android:id="@+id/navSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/nav_search"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_search" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navFilesWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:id="@+id/navFilesPill"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
            <ImageButton
                android:id="@+id/navFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/nav_files"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_files" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navInfoWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:id="@+id/navInfoPill"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
            <ImageButton
                android:id="@+id/navInfo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/nav_info"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_info" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
